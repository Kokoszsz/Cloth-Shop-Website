# Copy this file to .env before running `docker compose up`.
# docker compose reads .env automatically from this directory.

# Signs the session cookie. Must be secret and stable across restarts.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Which settings class Web/config.py selects: development, testing or production.
APP_ENV=production

# SQLAlchemy database URL. Four slashes mean an absolute path; /data is the
# named volume, so the database survives a rebuild.
DATABASE_URL=sqlite:////data/mydb.db
