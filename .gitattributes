# Normalise line endings: LF in the repository, native in the working tree.
# Without this, files committed from Windows land as CRLF and every later diff
# shows the whole file as changed.
* text=auto

# Shell scripts copied into a Linux container must keep LF endings, or the
# kernel reads the CR as part of the interpreter path and refuses to run them.
*.sh      text eol=lf

# Treat these as binary so git never rewrites their bytes.
*.db      binary
*.docx    binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.eot     binary
*.ttf     binary
*.woff    binary
*.woff2   binary
